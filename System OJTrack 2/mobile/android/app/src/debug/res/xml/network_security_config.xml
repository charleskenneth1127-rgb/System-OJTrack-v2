<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only: allows plain HTTP to the Firebase Local Emulator Suite.
     Reached via 10.0.2.2/localhost from the Android emulator, but a real
     device on the same Wi-Fi needs the host machine's actual LAN IP instead
     (see EMULATOR_HOST in mobile/lib/main.dart) — that address changes
     with every network, so this allows cleartext broadly rather than
     hardcoding one IP. Android 9+ blocks cleartext traffic by default; this
     file is debug-only and never bundled into a release build. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
